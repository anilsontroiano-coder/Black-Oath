; BLACK OATH — Godot 4.4.1 ou superior.
config_version=5

[application]
config/name="BLACK OATH"
config/version="0.5.0"
run/max_fps=60
run/main_scene="res://cenas/principal.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://arte/icone.svg"

[display]
window/size/viewport_width=480
window/size/viewport_height=854
window/size/window_width_override=480
window/size/window_height_override=854
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.06, 1)

[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[debug]
gdscript/warnings/treat_warnings_as_errors=true
