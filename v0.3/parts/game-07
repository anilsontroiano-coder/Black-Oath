function finalizarBatalha(v) {
    const ganhou = v === 'jogador';
    if (batalhaTipo === 'caçada') {
        if (ganhou && cacadaAtual) {
            run.ouro += cacadaAtual.recompensa.ouro;
            run.corrupcao = Math.min(100, run.corrupcao + (cacadaAtual.recompensa.corrupcao ?? 0));
            salvar();
            const drop = Math.random() < (cacadaAtual.recompensa.chanceItem ?? 0);
            if (drop)
                return recompensaCacada(itemAleatorio(), cacadaAtual.recompensa.ouro);
            return resultadoBatalha(true, `+${cacadaAtual.recompensa.ouro} Ouro`, () => { cacadaAtual = null; avancar(); });
        }
        run.determinacao -= 1;
        salvar();
        return resultadoBatalha(false, '-1 Determinação', () => { cacadaAtual = null; avancar(); });
    }
    if (batalhaTipo === 'chefe') {
        if (ganhou)
            return fimDeJogo(true);
        run.determinacao -= 3;
        run.chefeLiberado = false;
        run.vitorias = Math.max(0, ALVO_VITORIAS - 1);
        salvar();
        return resultadoBatalha(false, '-3 Determinação · o Rei ainda espera', () => { if (run.determinacao <= 0)
            fimDeJogo(false);
        else {
            run.ciclo++;
            iniciarCiclo();
        } });
    }
    if (ganhou) {
        run.vitorias++;
        const ouro = 5 + run.ciclo;
        run.ouro += ouro;
        salvar();
        resultadoBatalha(true, `+${ouro} Ouro`, aposDuelo);
    }
    else {
        run.determinacao -= 2;
        salvar();
        resultadoBatalha(false, '-2 Determinação', aposDuelo);
    }
}
